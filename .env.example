# Copy this file to .env and fill in real values. .env is git-ignored.

# ── Local backend (lives in THIS repo: panel login + leads) ─────────────
# MongoDB for agents + leads. Local mongod by default; on Heroku point
# this at your own Atlas cluster.
MONGO_URI=mongodb://127.0.0.1:27017/dashen-cpanel
# Signs login tokens — any long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Shared secret external systems send as `x-api-key` to POST /api/leads/intake.
LEADS_INTAKE_KEY=
# LOCAL_AUTH=1: this server owns login (standalone). LOCAL_AUTH=0: the main
# backend at API_TARGET owns login and MONGO_URI must be ITS database (the
# leads module validates tokens against the shared agents collection).
LOCAL_AUTH=1
# The leads pipeline (/api/leads/*) — keep on.
LOCAL_LEADS=1
# First user:  npm run seed:admin -- --name admin --password 'secret'

# ── External backend (the separate ~130-endpoint client/campaign API) ──
# No default — must point at your own backend's origin, e.g. https://api.yourdomain.co.il
API_TARGET=
VITE_API_URL=
# Usually left as the default "/api" (same-origin, proxied by server.js) —
# only set this to a full origin if the SPA is served from a different
# host than the API.
VITE_API_BASE=/api
VITE_SOCKET_URL=
PORT=3000

# Only needed right after migrating data from a previous backend whose
# absolute image URLs are still baked into old DB rows. Comma-separated
# hostnames. Leave empty on a fresh install.
VITE_LEGACY_IMG_HOSTS=

# ── Local ad-generation pipeline (replaces the old Make.com webhook) ───
# Stage 1 (ad copywriting) — OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Stage 2+3 (image prompt + image generation) — Gemini. campaign.md is
# read verbatim as the stage-2 system prompt; edit that file to change
# creative direction without touching code.
GEMINI_API_KEY=
GEMINI_HTML_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Facebook OAuth reconnect (replaces the old Make.com webhook) ───────
# Your own Facebook App (App ID is public — safe in a browser URL; the
# secret stays server-side only).
VITE_FB_APP_ID=
VITE_FB_LOGIN_CONFIG_ID=
FB_APP_ID=
FB_APP_SECRET=
FB_API_VERSION=v21.0
# Must be a public HTTPS URL Facebook can redirect the browser to —
# cannot be localhost. Point both at your deployed server's
# /auth/facebook/callback route.
VITE_FB_OAUTH_REDIRECT_URI=
FB_OAUTH_REDIRECT_URI=
# Optional: your backend's own endpoint to receive the exchanged token
# (phone/page_id come through as `state`). If unset, the callback page
# just displays the token for manual handling.
FB_TOKEN_WEBHOOK_URL=
