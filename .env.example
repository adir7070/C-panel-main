# Copy this file to .env and fill in real values. .env is git-ignored.
#
# One process serves everything: `npm start` / `npm run dev` run
# backend/server.js, which also mounts the panel's own routes
# (server/panel.js) and serves the built SPA. In local dev the backend
# reads its own keys from backend/.env.development (git-ignored); values in
# this .env win for any key set in both. In production every value is a
# Heroku config var — no .env file is read there.

# ── Shared ─────────────────────────────────────────────────────────────
# The ONE MongoDB database the backend and the panel's leads module share.
# The database name must be in the path (…/dashen) — without it the driver
# silently uses "test".
MONGO_URI=mongodb://127.0.0.1:27017/dashen
PORT=3910

# Shared secret external systems send as `x-api-key` to POST /api/leads/intake.
LEADS_INTAKE_KEY=

# Leave these unset: the SPA calls /api and opens its socket on its own origin.
# VITE_API_BASE=/api
# VITE_SOCKET_URL=

# Only needed right after migrating data from a previous backend whose
# absolute image URLs are still baked into old DB rows. Comma-separated
# hostnames. Leave empty on a fresh install.
VITE_LEGACY_IMG_HOSTS=

# ── Local ad-generation pipeline (server/localAdsPipeline.js) ─────────
# campaign.md is read verbatim as the stage-2 system prompt.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_HTML_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Facebook OAuth reconnect (GET /auth/facebook/callback) ─────────────
# Your own Facebook App (App ID is public — safe in a browser URL; the
# secret stays server-side only). Both redirect URIs must be the public
# HTTPS origin + /auth/facebook/callback.
VITE_FB_APP_ID=
VITE_FB_LOGIN_CONFIG_ID=
FB_APP_ID=
FB_APP_SECRET=
FB_API_VERSION=v21.0
VITE_FB_OAUTH_REDIRECT_URI=
FB_OAUTH_REDIRECT_URI=
FB_TOKEN_WEBHOOK_URL=

# ── Backend keys ───────────────────────────────────────────────────────
# SERVER_BASE_URL, BASE_URL, CPANEL_BASE_URL (all = this app's origin),
# GREEN_API_*, CARDCOM_*, DISABLE_WHOAPP=true, DISABLE_WOW_BETA=true, …
# live in backend/.env.development locally and in Heroku config vars.
