*-service-account.json
react-native-iconiq-app-*.json

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Allow built frontend dist folders served by this server
!public/admin-dashboard/dist/
!public/admin-dashboard/dist/**
!public/app-admin/dist/
!public/app-admin/dist/**

