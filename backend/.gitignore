.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
/.claude
.DS_Store
/generated-images

# WOW BETA runtime data (sessions, uploads, briefs) — ephemeral local state
wow-beta/backend/data/

# Local-only agent test CLI — disables TLS verification for this dev box; never deploy
agent-cli.js


# Credentials and data dumps — never commit (Google keys come from
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET config vars instead)
/client_secret_web.json
/drive_services_acc.json
/firebary.json
/meta.json

# Generated invoice/receipt PDFs (runtime output, may contain customer data)
/invoices/*.pdf
